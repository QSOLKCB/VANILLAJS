(module (memory (export "memory") 256 256)
(func (export "project") (param $src i32) (param $dst i32) (param $mat i32) (param $count i32)
(block $done (loop $next (br_if $done (i32.eqz (local.get $count)))
(f32.store offset=0 (local.get $dst) (f32.add (f32.add (f32.add (f32.mul (f32.load offset=0 (local.get $src)) (f32.load offset=0 (local.get $mat))) (f32.mul (f32.load offset=4 (local.get $src)) (f32.load offset=16 (local.get $mat)))) (f32.mul (f32.load offset=8 (local.get $src)) (f32.load offset=32 (local.get $mat)))) (f32.load offset=48 (local.get $mat))))
(f32.store offset=4 (local.get $dst) (f32.add (f32.add (f32.add (f32.mul (f32.load offset=0 (local.get $src)) (f32.load offset=4 (local.get $mat))) (f32.mul (f32.load offset=4 (local.get $src)) (f32.load offset=20 (local.get $mat)))) (f32.mul (f32.load offset=8 (local.get $src)) (f32.load offset=36 (local.get $mat)))) (f32.load offset=52 (local.get $mat))))
(f32.store offset=8 (local.get $dst) (f32.add (f32.add (f32.add (f32.mul (f32.load offset=0 (local.get $src)) (f32.load offset=8 (local.get $mat))) (f32.mul (f32.load offset=4 (local.get $src)) (f32.load offset=24 (local.get $mat)))) (f32.mul (f32.load offset=8 (local.get $src)) (f32.load offset=40 (local.get $mat)))) (f32.load offset=56 (local.get $mat))))
(f32.store offset=12 (local.get $dst) (f32.add (f32.add (f32.add (f32.mul (f32.load offset=0 (local.get $src)) (f32.load offset=12 (local.get $mat))) (f32.mul (f32.load offset=4 (local.get $src)) (f32.load offset=28 (local.get $mat)))) (f32.mul (f32.load offset=8 (local.get $src)) (f32.load offset=44 (local.get $mat)))) (f32.load offset=60 (local.get $mat))))
(f32.store offset=16 (local.get $dst) (f32.load offset=12 (local.get $src)))
(f32.store offset=20 (local.get $dst) (f32.load offset=16 (local.get $src)))
(f32.store offset=24 (local.get $dst) (f32.load offset=20 (local.get $src)))
(local.set $src (i32.add (local.get $src) (i32.const 24)))
(local.set $dst (i32.add (local.get $dst) (i32.const 28)))
(local.set $count (i32.sub (local.get $count) (i32.const 1))) (br $next)))))
