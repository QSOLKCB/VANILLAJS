{
  "schemaVersion": 1,
  "release": "1.0.0",
  "license": "Apache-2.0",
  "modules": {
    "math": {
      "entry": "modules/math/index.js",
      "depends": [],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Vectors, quaternions, matrices and seeded randomness"
    },
    "time": {
      "entry": "modules/time/index.js",
      "depends": [],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Fixed simulation ticks, interpolation and pause"
    },
    "collision": {
      "entry": "modules/collision/index.js",
      "depends": [
        "math"
      ],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Static and translating AABB sweeps, body sliding, finite shots and bounded kinematic contacts"
    },
    "flight": {
      "entry": "modules/flight/index.js",
      "depends": [
        "math",
        "collision"
      ],
      "environment": "pure-js",
      "status": "experimental",
      "description": "6DOF rigid-body integration, assisted/inertial control and direct mouse look"
    },
    "input": {
      "entry": "modules/input/index.js",
      "depends": [
        "math"
      ],
      "environment": "pure state with opt-in browser adapter",
      "status": "experimental",
      "description": "Action state, keyboard/mouse lifecycle and standard gamepad mapping"
    },
    "render-webgl": {
      "entry": "modules/render-webgl/index.js",
      "depends": [
        "math"
      ],
      "environment": "browser-webgl1",
      "status": "experimental",
      "description": "Minimal coloured geometry, lines, points and camera rendering"
    },
    "projectiles": {
      "entry": "modules/projectiles/index.js",
      "depends": [
        "math",
        "collision"
      ],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Bounded straight projectiles against static or translating targets, ordered impacts and lifetimes"
    },
    "interactions": {
      "entry": "modules/interactions/index.js",
      "depends": [],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Declarative conditions and effects with ordered resolution and explanatory outcomes"
    },
    "character": {
      "entry": "modules/character/index.js",
      "depends": [
        "math",
        "collision"
      ],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Grounded walking, crouching, jumping and static stairs or translating-platform riding"
    },
    "weapons": {
      "entry": "modules/weapons/index.js",
      "depends": [],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Simulation-time magazines, fire cadence and finite-reserve reloading"
    },
    "navigation": {
      "entry": "modules/navigation/index.js",
      "depends": [],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Immutable X/Z grids, bounded A*, group destinations and incremental shared flow fields"
    },
    "geometry": {
      "entry": "modules/geometry/index.js",
      "depends": [
        "collision"
      ],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Exact Float32 box batching, conservative ternary frustum classification and bounded static AABB indexing"
    },
    "terrain": {
      "entry": "modules/terrain/index.js",
      "depends": [
        "math"
      ],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Bounded immutable triangulated heightfield, sampling and ridge-safe continuous segment crossings"
    },
    "ballistics": {
      "entry": "modules/ballistics/index.js",
      "depends": [],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Closed-form bounded constant-gravity vertical stepping with explicit ground clamping"
    },
    "adaptive-circles": {
      "entry": "modules/adaptive-circles/index.js",
      "depends": [],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Immutable 2D circle snapshots with adaptive serial brute-force/grid swept-hit queries"
    },
    "cuboid-stream": {
      "entry": "modules/cuboid-stream/index.js",
      "depends": [],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Retained Float32 cuboid instance stream, exact encoded input and deterministic distance LOD"
    },
    "integer-math": {
      "entry": "modules/integer-math/index.js",
      "depends": [],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Checked signed fixed-point arithmetic, integer square root and explicit uint32 PRNG"
    },
    "integer-vector": {
      "entry": "modules/integer-vector/index.js",
      "depends": [
        "integer-math"
      ],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Checked 16.16 vector operations with exact BigInt dot/cross/distance intermediates and rational interpolation"
    },
    "integer-time": {
      "entry": "modules/integer-time/index.js",
      "depends": [
        "integer-math"
      ],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Integer microsecond scheduling, rational tick phase and bounded catch-up"
    },
    "integer-physics": {
      "entry": "modules/integer-physics/index.js",
      "depends": [
        "integer-math"
      ],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Integer X/Y/Z axis sweeps against immutable static AABBs"
    },
    "integer-engine": {
      "entry": "modules/integer-engine/index.js",
      "depends": [
        "integer-math",
        "integer-physics"
      ],
      "environment": "pure-js",
      "status": "experimental",
      "description": "Atomic integer simulation ticks, canonical snapshots and bounded replay"
    }
  },
